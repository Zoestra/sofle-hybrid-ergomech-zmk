#define ZMK_POINTING_DEFAULT_SCRL_VAL 300

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers { compatible = "zmk,conditional-layers"; };

    behaviors {
        mousescroll: mousescroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        hold_tap_hold: hold_tap_hold {
            compatible = "zmk,behavior-tap-dance";
            label = "HOLD_TAP_HOLD";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 4>;
        };

        ctrl_mod: ctrl_mod {
            compatible = "zmk,behavior-tap-dance";
            label = "CTRL_MOD";
            #binding-cells = <0>;
            bindings = <&kp LCTRL>, <&mo 5>;
        };

        ctrl_adjust: ctrl_adjust {
            compatible = "zmk,behavior-tap-dance";
            label = "CTRL_ADJUST";
            #binding-cells = <0>;
            bindings = <&kp LCTRL>, <&mo 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESCAPE        &kp N1    &kp N2    &kp N3     &kp N4     &kp N5          &kp N6     &kp N7     &kp N8        &kp N9          &kp N0     &kp BACKSPACE
&kp TAB           &kp Q     &kp W     &kp E      &kp R      &kp T           &kp Y      &kp U      &kp I         &kp O           &kp P      &kp DELETE
&mt LCTRL ESCAPE  &kp A     &kp S     &kp D      &kp F      &kp G           &kp H      &kp J      &kp K         &kp L           &kp SEMI   &kp SQT
&kp LSHFT         &kp Z     &kp X     &kp C      &kp V      &kp B           &kp N      &kp M      &kp COMMA     &kp DOT         &kp FSLH   &mt RSHFT ENTER
&kp K_PLAY_PAUSE  &kp LGUI  &kp LALT  &ctrl_mod  &kp SPACE  &hold_tap_hold  &mo 2      &kp SPACE  &ctrl_adjust  &kp LEFT_ARROW  &kp RIGHT
                                                                            &kp ENTER  &kp RIGHT  &kp UP        &kp LEFT        &kp DOWN
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP K_VOLUME_DOWN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            label = "lower";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&studio_unlock  &kp F1     &kp F2     &kp F3    &kp F4    &kp F5     &kp F6     &kp F7     &kp F8     &kp F9     &kp F10   &kp F11
&kp GRAVE       &kp N1     &kp N2     &kp N3    &kp N4    &kp N5     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0    &kp F12
&trans          &kp EXCL   &kp AT     &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR  &kp PIPE
&trans          &kp EQUAL  &kp MINUS  &kp PLUS  &kp LBRC  &kp RBRC   &kp LBKT   &kp RBKT   &kp SEMI   &kp COLON  &kp BSLH  &trans
&trans          &trans     &trans     &trans    &trans    &trans     &kp MINUS  &kp UNDER  &trans     &trans     &trans
                                                                     &trans     &trans     &trans     &trans     &trans
            >;

            sensor-bindings =
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            label = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&trans  &trans  &trans         &trans         &trans         &kp LESS_THAN         &kp GREATER_THAN       &tog 3           &trans           &trans           &kp ASTERISK  &trans
&trans  &trans  &trans         &trans         &trans         &kp LBRC              &kp RBRC               &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp SLASH     &trans
&trans  &trans  &trans         &trans         &trans         &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp MINUS     &trans
&trans  &trans  &kp LC(LS(X))  &kp LC(LS(C))  &kp LC(LS(V))  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PLUS      &trans
&trans  &trans  &trans         &trans         &trans         &trans                &trans                 &trans           &kp NUMBER_0     &kp UP_ARROW     &kp DOWN
                                                                                   &trans                 &kp END          &kp PG_UP        &kp HOME         &kp PG_DN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            label = "adjust";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none   &none   &bt BT_CLR_ALL
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF  &none         &none         &none         &none   &none   &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none            &none         &none         &none         &none   &none   &none
&none              &none            &none            &none            &none            &none            &none         &none         &none         &none   &none   &none
&rgb_ug RGB_TOG    &none            &none            &none            &none            &none            &none         &none         &trans        &none   &none
                                                                                                        &trans        &trans        &trans        &trans  &trans
            >;
        };

        mirror {
            bindings = <
&kp BACKSPACE   &kp N0         &kp N9      &kp N8     &kp N7  &kp NUMBER_6  &trans     &trans  &trans  &trans  &trans  &trans
&kp DELETE      &kp P          &kp O       &kp I      &kp U   &kp Y         &trans     &trans  &trans  &trans  &trans  &trans
&kp SQT         &kp SEMICOLON  &kp L       &kp K      &kp J   &kp H         &kp PLUS   &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp SLASH      &kp PERIOD  &kp COMMA  &kp N   &kp N         &kp EQUAL  &trans  &trans  &trans  &trans  &trans
&trans          &kp ENTER      &trans      &trans     &trans  &trans        &mo 2      &trans  &trans  &trans  &trans
                                                                            &trans     &trans  &trans  &trans  &trans
            >;

            label = "mirror";
        };

        mod {
            bindings = <
&kp GRAVE  &trans  &trans  &trans  &kp LA(F4)  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                                                       &trans  &trans  &trans  &trans  &trans
            >;

            label = "mod";
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
